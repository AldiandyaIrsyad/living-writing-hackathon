    "scenes": {
      "sc_1": {
        "id": "sc_1",
        "title": "Supper at the Inn",
        "storyId": "story_main",
        "chapterId": "ch_1",
        "order": 0,
        "momentId": "m_1",
        "prose": "[[norman]] is eating his food.\n\nAcross the table, [[Alice]] and [[Bob]] argue quietly over the price of ale. The fire is low, and the [[Sword of Ash]] hangs above the hearth, black against the stones."
      },
      "sc_2": {
        "id": "sc_2",
        "title": "The Stranger",
        "storyId": "story_main",
        "chapterId": "ch_2",
        "order": 1,
        "momentId": "m_2",
        "prose": "A stranger comes in from the rain and asks for [[Norman]] by name. [[Mira]] watches from the doorway, her cloak still wet. [[Alice]] and [[Bob]] laugh together at the far table, not yet knowing what the night will cost them."
      },
      "sc_3": {
        "id": "sc_3",
        "title": "The Betrayal",
        "storyId": "story_main",
        "chapterId": "ch_3",
        "order": 2,
        "momentId": "m_3",
        "prose": "[[Bob]] says the words [[Alice]] will never forget. By morning their friendship lies broken on the floor of the [[Ashford]] inn."
      },
      "sc_4": {
        "id": "sc_4",
        "title": "Gathering Storm",
        "storyId": "story_main",
        "chapterId": "ch_4",
        "order": 3,
        "momentId": "m_4",
        "prose": "Clouds pile up over the hills above [[Ashford]]. [[Mira]] counts the coins in her purse and decides to leave before the storm breaks."
      },
      "sc_5": {
        "id": "sc_5",
        "title": "The Fall of Ashford",
        "storyId": "story_main",
        "chapterId": "ch_5",
        "order": 4,
        "momentId": "m_5",
        "prose": "The gates of [[Ashford]] give way at dusk. [[Norman]] falls defending the inn, and the town burns until the sky is red. Little of [[Ashford]] is left standing."
      },
      "sc_m1": {
        "id": "sc_m1",
        "title": "Crossroads",
        "storyId": "story_mira",
        "chapterId": null,
        "order": 0,
        "momentId": "m_m1",
        "prose": "[[Mira]] reaches the crossroads at first light. One road leads back to [[Ashford]]; the other climbs into the hills. She stands there longer than she means to."
      },
      "sc_m2": {
        "id": "sc_m2",
        "title": "The Sword in the Ash",
        "storyId": "story_mira",
        "chapterId": null,
        "order": 1,
        "momentId": "m_m2",
        "prose": "Among the ashes of the old road, [[Mira]] finds the [[Sword of Ash]] half buried in cinders. She lifts it, and it is heavier than it should be. From now on it is hers to carry."
      }
    },
