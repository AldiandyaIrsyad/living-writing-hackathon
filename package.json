{
  "name": "living-writing",
  "version": "1.0.0",
  "description": "A local-first writing tool: a timeline of scenes with a wiki of entities, built for long projects.",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch server/main.ts",
    "dev:full": "node scripts/dev-full.mjs",
    "dev:gemini": "node scripts/dev-full.mjs --provider=gemini",
    "build": "tsc && vite build",
    "build:full": "tsc && vite build --mode backend",
    "start": "node server/main.ts",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "check": "tsc --noEmit && npm run lint && npm test",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:backend": "playwright test --config playwright.backend.config.ts",
    "bench:scale": "vitest run --config vitest.scale.config.ts"
  },
  "type": "module",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.7",
    "@lezer/highlight": "^1.2.5",
    "dexie": "^4.4.6",
    "fastify": "^5.12.7",
    "jszip": "^3.10.2",
    "markdown-it": "^15.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "private": true
}
